/-- The serialized factor table has exactly one entry per node, coordinate and value. -/
theorem rawWeightsMinusOne_size :
    rawWeightsMinusOne.size = 126 * 3 * 5 := by decide

/-- Recover the exact positive factor selected for one coordinate value. -/
def weight (node coordinate value : ℕ) : ℕ :=
  rawWeightsMinusOne[node * 15 + coordinate * 5 + value]?.getD 0 + 1

/-- Every serialized factor is strictly positive, structurally. -/
theorem weight_pos (node coordinate value : ℕ) : 0 < weight node coordinate value := by
  simp [weight]

/-- Product-family factors for one positive level-three node. -/
def dualWeights (node : ℕ) : DualWeights :=
  { x := fun value ↦ weight node 0 value
    y := fun value ↦ weight node 1 value
    z := fun value ↦ weight node 2 value }

/-- Every `X` factor in the product-family witness is positive. -/
